generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Team {
  id       String    @id
  name     String
  league   String
  country  String
  accent   String
  products Product[]

  @@map("teams")
}

model Category {
  id          String    @id
  name        String
  description String    @db.Text
  products    Product[]

  @@map("categories")
}

model SizeOption {
  id String @id

  @@map("sizes")
}

model Product {
  id              String         @id
  slug            String         @unique
  name            String
  teamId          String
  categoryId      String
  basePrice       Int
  packPrice       Int
  flockingPrice   Int
  description     String         @db.Text
  visualPrimary   String
  visualSecondary String
  visualTrim      String
  visualPattern   String
  isNew           Boolean        @default(false)
  isPopular       Boolean        @default(false)
  allowFlocking   Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        Category       @relation(fields: [categoryId], references: [id])
  team            Team           @relation(fields: [teamId], references: [id])
  images          ProductImage[]
  reviews         ProductReview[]
  stocks          ProductStock[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String
  url       String  @db.LongText
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductStock {
  id        Int     @id @default(autoincrement())
  productId String
  size      String
  quantity  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("product_stocks")
}

model ProductReview {
  id           Int      @id @default(autoincrement())
  productId    String
  customerName String
  rating       Int
  comment      String   @db.Text
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_reviews")
}

model Order {
  id              String      @id
  reference       String      @unique
  customerName    String
  customerPhone   String
  customerCity    String
  customerAddress String      @db.Text
  subtotal        Int
  total           Int
  status          String      @default("new")
  whatsappMessage String      @db.LongText
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         String
  cartItemId      String
  productId       String
  productName     String
  teamName        String
  size            String
  type            String
  quantity        Int
  unitPrice       Int
  lineTotal       Int
  flockingMode    String
  flockingName    String?
  flockingNumber  String?
  flockingPlayer  String?
  flockingNote    String? @db.Text
  visualPrimary   String
  visualSecondary String
  visualTrim      String
  visualPattern   String
  image           String? @db.LongText
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}
